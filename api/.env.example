PORT=3000

# URL base do webservice HML (seletor ENVIRONMENT no catálogo Gera).
# Não use https://api.gera.com.br — isso é só a documentação.
GERA_BASE_URL=https://hmlapi.revendedorloccitaneaubresil.com

# Autenticação (token público)
GERA_TOKEN_PATH=/api/token
GERA_GRANT_TYPE=password
GERA_CLIENT_ID=IntegradorLOccitane
GERA_CLIENT_SECRET=
GERA_USERNAME=2315
GERA_PASSWORD=

# Cadastro
GERA_SELLERS_PATH=/api/Public/Sellers
GERA_DOCUMENT_TYPE_CPF=1
GERA_INDICATOR_CODE=2315
GERA_REGISTRATION_ORIGIN=

# Opcional: consulta de CEP/estrutura geográfica na Gera (ex.: /api/Public/GeographicStructures)
GERA_ZIPCODE_PATH=
GERA_LOOKUP_PATHS=/api/Public/People?mainDocument={cpf},/api/Public/People?email={email},/api/Public/Sellers?mainDocument={cpf},/api/Public/Sellers?email={email}
GERA_SELLER_GET_PATH=/api/Public/Sellers/{code}

# OTP Indico (https://lp-collector-api-420251628326.us-east1.run.app/api-docs/otp.html)
INDICO_API_BASE=https://lp-collector-api-420251628326.us-east1.run.app
INDICO_DB_ID=
INDICO_OTP_PURPOSE=registration
INDICO_ORIGIN=http://localhost:3000
RECAPTCHA_SITE_KEY=6LelYIwtAAAAAJRr3znOPR5gQog-rJ_hawhFua80
