PORT=3000

# URL base do webservice HML (seletor ENVIRONMENT no catálogo Gera).
# Não use https://api.gera.com.br — isso é só a documentação.
GERA_BASE_URL=https://hmlapi.revendedorloccitaneaubresil.com

# Autenticação (token público)
GERA_TOKEN_PATH=/api/token
GERA_GRANT_TYPE=password
GERA_CLIENT_ID=IntegradorLOccitane
GERA_CLIENT_SECRET=
GERA_USERNAME=2315
GERA_PASSWORD=

# Cadastro
GERA_SELLERS_PATH=/api/Public/Sellers
GERA_DOCUMENT_TYPE_CPF=2
GERA_INDICATOR_CODE=2315
GERA_REGISTRATION_ORIGIN=

# Consulta o logradouro na árvore geográfica da Gera (nível 4).
GERA_ZIPCODE_PATH=/api/Public/GeographicalStructures?postalCode={cep}
GERA_LOOKUP_PATHS=/api/public/validateNewRegisterDocument?value={cpf}&type=2,/api/public/validateNewRegisterDocument?value={cpf}&type=1,/api/public/people?document={cpf}&typeDocument=2,/api/public/people?document={cpf}&typeDocument=1,/api/public/people?email={email},/api/people?document={cpf}&includeOptions=documents&includeOptions=emails,/api/sellers?functionCode=1&document={cpf}&includeOptions=documents&includeOptions=emails,/api/sellers?functionCode=1&email={email}&includeOptions=emails
GERA_SELLER_GET_PATH=/api/Public/Sellers/{code}
GERA_PASSWORD_PATH=/api/people/{id}
GERA_ESCRITORIO_URL=

# OTP Indico staging (https://lp-collector-api-670020683031.us-east1.run.app/api-docs/otp.html)
INDICO_API_BASE=https://lp-collector-api-670020683031.us-east1.run.app
INDICO_DB_ID=
INDICO_OTP_PURPOSE=registration
# Em produção, use a URL pública do site (e libere essa origem no destino Indico).
INDICO_ORIGIN=http://localhost:3000
# Só em HML/local: mostra o PIN na tela se o e-mail da Indico não chegar.
OTP_DEV_REVEAL=0
RECAPTCHA_SITE_KEY=6LfHgoQtAAAAAE8HUhp3VcrQh9j__qFgHDE5Pn9o
